# Local Claude Code settings. Machine-specific (enabled MCP servers, local
# permissions) and must not propagate to projects copied from this template.
.claude/settings.local.json

# --- Node / Next.js ---------------------------------------------------------
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo

# Test and tooling output
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# Local environment. Never commit these — see docs/CUSTOMIZATION.md step 8 on
# where deploy credentials actually belong (Environment secrets, not files).
.env
.env.*
!.env.example
!.env.*.example

# Fixture-mode upload store. Holds resale certificates, which carry a state
# licence number and an EIN. Must never reach the repository.
.uploads/

# OS noise
.DS_Store
Thumbs.db

# Local credentials and agent state (shared .claude settings remain tracked)
*.pem
*.key
*.p12
*.pfx
.aws/
.codex/
.agents/

# Package-manager caches and diagnostic output
.pnpm-store/
.npm/
*.log

# Cloudflare Workers toolchain output and local state (vinext, the Vite
# plugin and the cf CLI). .cloudflare/state holds the local D1 database.
.vinext/
.cloudflare/
.wrangler/

# Local Worker secrets. The tracked .dev.vars.example lists the keys.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Exported builds and tooling caches
out/
dist/
.cache/
.eslintcache
.stylelintcache
.vercel/
.turbo/

# Editor and OS temporary files
.idea/
.vscode/
*.swp
*.swo
*~
Desktop.ini

# Original local planning scratchpad; launch scope is summarized in README
/I want a simple, professional Smoke.txt
