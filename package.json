{
  "name": "smoke-show-labs",
  "version": "0.1.0",
  "private": true,
  "description": "Smoke Show Labs — wholesale lead-capture site for licensed cannabis operators",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "build:local": "vite build --mode local-preview",
    "preview": "vite preview --port 4173 --strictPort",
    "deploy": "vinext-cloudflare deploy --skip-build",
    "typecheck": "cf workers types && tsc --noEmit",
    "lint:es": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "lint:format": "prettier --check .",
    "lint": "cf workers types && tsc --noEmit && eslint . && stylelint \"src/**/*.css\" --allow-empty-input && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:types": "cf workers types",
    "db:migrate:local": "cf d1 migrations apply 00000000-0000-4000-8000-000000000001 --local --dir migrations --persist-to .cloudflare/state",
    "db:migrate:staging": "cf d1 migrations apply $DB_ID_STAGING --mode staging --dir migrations",
    "db:migrate:prod": "cf d1 migrations apply $DB_ID_PRODUCTION --mode production --dir migrations"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.1.0",
    "next": "^16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "server-only": "^0.0.1",
    "vinext": "1.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "cf": "1.0.0-beta.16",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "8.5.30",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.0",
    "vite-css-modules": "1.16.0",
    "vitest": "^5.0.0"
  },
  "type": "module"
}
